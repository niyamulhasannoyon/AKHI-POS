        <!-- Khamari Daily Entry View -->
        <div id="khamari-view" class="main-view hidden h-full overflow-y-auto p-4 md:p-8">
            <h2
                class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-yellow-400 mb-6">
                Khamari - Daily Accounts</h2>

            <div
                class="glass-panel p-6 rounded-xl mb-6 border border-amber-500/20 relative shadow-lg shadow-amber-900/10">
                <div class="absolute top-0 right-0 w-48 h-48 bg-amber-500/5 rounded-full blur-3xl pointer-events-none">
                </div>
                <h3 class="font-bold text-white mb-4 text-sm uppercase tracking-wider border-b border-white/10 pb-2">
                    Record Daily Distributions</h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div>
                        <label class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1 block">Date</label>
                        <input type="date" id="khamari-date"
                            class="w-full input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10 focus:border-amber-500 outline-none">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1 block">Select Farm
                            (Khamar)</label>
                        <select id="khamari-farm-select"
                            class="w-full input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10 text-gray-300 focus:border-amber-500 outline-none">
                            <option class="text-gray-900" value="">Select Farm</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Feed Section -->
                    <div class="bg-white/5 border border-white/5 p-4 rounded-xl space-y-3">
                        <h4
                            class="font-bold text-amber-500 text-xs uppercase tracking-widest border-b border-white/10 pb-1 mb-2">
                            1. Feed & Gura</h4>
                        <div class="flex gap-2">
                            <input type="text" id="khamari-feed-dealer"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Dealer Name">
                            <input type="text" id="khamari-feed-company"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Company Name">
                        </div>
                        <div class="flex gap-2">
                            <input type="number" id="khamari-sonali-feed-qty"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Sonali Feed Qty (kg/sack)">
                            <input type="number" id="khamari-sonali-feed-rate"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Rate (৳)">
                        </div>
                        <div class="flex gap-2">
                            <input type="number" id="khamari-broiler-feed-qty"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Broiler Feed Qty">
                            <input type="number" id="khamari-broiler-feed-rate"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Rate (৳)">
                        </div>
                        <div class="flex gap-2">
                            <input type="number" id="khamari-gura-qty"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Gura Qty">
                            <input type="number" id="khamari-gura-rate"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Rate (৳)">
                        </div>
                        <p class="text-[10px] text-amber-400 font-medium opacity-80">* Use negative qty (-) for
                            returning feed.</p>
                    </div>

                    <!-- Chicks Section -->
                    <div class="bg-white/5 border border-white/5 p-4 rounded-xl space-y-3">
                        <h4
                            class="font-bold text-emerald-500 text-xs uppercase tracking-widest border-b border-white/10 pb-1 mb-2">
                            2. Delivery: Chicks</h4>
                        <div class="flex gap-2">
                            <input type="number" id="khamari-sonali-chick-qty"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Sonali Chicks (pcs)">
                            <input type="number" id="khamari-sonali-chick-rate"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Rate (৳)">
                        </div>
                        <div class="flex gap-2">
                            <input type="number" id="khamari-broiler-chick-qty"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Broiler Chicks (pcs)">
                            <input type="number" id="khamari-broiler-chick-rate"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Rate (৳)">
                        </div>
                    </div>

                    <!-- Medicine & Vacc -->
                    <div class="bg-white/5 border border-white/5 p-4 rounded-xl space-y-3">
                        <h4
                            class="font-bold text-purple-400 text-xs uppercase tracking-widest border-b border-white/10 pb-1 mb-2">
                            3. Medicine & Vaccine</h4>
                        <div class="relative">
                            <input id="khamari-med-name"
                                class="w-full input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Search POS Medicine/Vaccine..." autocomplete="off">
                            <div id="khamari-med-results"
                                class="hidden absolute top-full left-0 w-full bg-gray-800 border border-white/10 shadow-lg rounded-b-lg max-h-48 overflow-y-auto z-[60]">
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <input type="number" id="khamari-med-qty"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Quantity">
                            <input type="number" id="khamari-med-rate"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Rate">
                            <button id="btn-add-khamari-med" type="button"
                                class="bg-purple-600 hover:bg-purple-500 text-white px-3 py-1.5 rounded-lg text-sm transition-colors">Add</button>
                        </div>
                        <!-- Multiple meds container -->
                        <div id="khamari-added-meds" class="max-h-24 overflow-y-auto space-y-1 mt-2 text-xs"></div>
                        <div class="flex gap-2 mt-4 pt-4 border-t border-white/5">
                            <input type="text" id="khamari-other-cost-desc"
                                class="flex-1 input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Other cost desc...">
                            <input type="number" id="khamari-other-cost"
                                class="flex-[0.5] input-field py-1.5 px-3 text-sm bg-gray-900/80 border-white/10"
                                placeholder="Amount">
                        </div>
                    </div>
                </div>

                <div class="mt-6 flex justify-end items-center pt-4">
                    <button id="btn-record-khamari"
                        class="bg-gradient-to-r from-amber-500 to-yellow-600 text-gray-900 rounded-xl px-12 py-3 text-sm font-extrabold shadow-lg shadow-amber-900/40 hover:scale-[1.02] transition-transform">SAVE
                        DAILY RECORD</button>
                </div>
            </div>

            <div class="glass-card rounded-xl overflow-hidden border border-white/5 relative bg-black/20">
                <div class="px-6 py-4 border-b border-white/10 bg-white/5 sticky top-0 z-20 backdrop-blur-md">
                    <h3 class="font-bold text-gray-300 text-xs uppercase tracking-wider">Khamari - Recent Detailed Logs
                    </h3>
                </div>
                <div class="overflow-x-auto min-h-[300px]">
                    <table class="w-full text-left whitespace-nowrap">
                        <thead class="bg-white/5 text-gray-400 text-xs uppercase font-semibold">
                            <tr>
                                <th class="p-3">Date</th>
                                <th class="p-3">Farm</th>
                                <th class="p-3">Breakdown</th>
                                <th class="p-3 text-right">Total Valid Bill</th>
                                <th class="p-3 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="khamari-table-body" class="divide-y divide-white/5">
                            <!-- Populated by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Feed Gura Management View -->
        <div id="feed-gura-mgmt-view" class="main-view hidden h-full overflow-y-auto p-4 md:p-8">
            <h2
                class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-amber-600 to-yellow-500 mb-6">
                Feed & Gura Management</h2>

            <div
                class="glass-panel p-6 rounded-xl mb-6 border border-amber-500/20 relative shadow-lg shadow-amber-900/10">
                <div class="absolute top-0 right-0 w-48 h-48 bg-amber-500/5 rounded-full blur-3xl pointer-events-none">
                </div>
                <h3 class="font-bold text-white mb-4 text-sm uppercase tracking-wider border-b border-white/10 pb-2">
                    Distribute Feed/Gura from Dealer</h3>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                    <div>
                        <label class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1 block">Date</label>
                        <input type="date" id="fgm-date"
                            class="w-full input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10 focus:border-amber-500 outline-none">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1 block">Dealer/Dilar
                            Name</label>
                        <input type="text" id="fgm-dealer"
                            class="w-full input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10 focus:border-amber-500 outline-none"
                            placeholder="e.g. Kamal Dilar">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1 block">Company
                            Name</label>
                        <input type="text" id="fgm-company"
                            class="w-full input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10 focus:border-amber-500 outline-none"
                            placeholder="e.g. Onefeed">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1 block">Feed
                            Type</label>
                        <select id="fgm-feed-type"
                            class="w-full input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10 focus:border-amber-500 outline-none">
                            <option value="Sonali Feed">Sonali Feed</option>
                            <option value="Broiler Feed">Broiler Feed</option>
                            <option value="Gura">Gura</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-4 mb-6" id="fgm-destinations-container">
                    <label class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1 block">Destinations
                        (Distribution)</label>
                    <div class="flex gap-2 items-center">
                        <select
                            class="fgm-khamar-select flex-1 input-field py-2 px-3 text-sm bg-gray-900/80 border-white/10 focus:border-amber-500 outline-none text-gray-300">
                            <!-- Populated heavily by JS -->
                        </select>
                        <input type="number"
                            class="fgm-qty flex-1 input-field py-2 px-3 text-sm bg-gray-900/80 border-white/10 focus:border-amber-500 outline-none"
                            placeholder="Quantity Distributed">
                        <button type="button" onclick="addFgmDestinationRow()"
                            class="bg-gray-800 hover:bg-gray-700 text-white p-2 rounded-lg">+</button>
                    </div>
                </div>

                <div class="mt-6 flex justify-end items-center pt-4 border-t border-white/10">
                    <button id="btn-save-fgm"
                        class="bg-gradient-to-r from-amber-600 to-yellow-600 text-gray-900 rounded-xl px-12 py-3 text-sm font-extrabold shadow-lg shadow-amber-900/40 hover:scale-[1.02] transition-transform">SAVE
                        DISTRIBUTION</button>
                </div>
            </div>

            <div class="glass-card rounded-xl overflow-hidden border border-white/5 relative bg-black/20">
                <div class="px-6 py-4 border-b border-white/10 bg-white/5 sticky top-0 z-20 backdrop-blur-md">
                    <h3 class="font-bold text-gray-300 text-xs uppercase tracking-wider">Recent Distributions
                    </h3>
                </div>
                <div class="overflow-x-auto min-h-[300px]">
                    <table class="w-full text-left whitespace-nowrap">
                        <thead class="bg-white/5 text-gray-400 text-xs uppercase font-semibold">
                            <tr>
                                <th class="p-3">Date</th>
                                <th class="p-3">Dealer & Company</th>
                                <th class="p-3">Feed Type</th>
                                <th class="p-3">Distribution Details</th>
                                <th class="p-3 text-right">Total Qty (Sacks)</th>
                                <th class="p-3 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="fgm-table-body" class="divide-y divide-white/5">
                            <!-- Populated by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- Dark Payment Modal -->
    <div id="payment-modal"
        class="modal-container hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-md p-4">
        <div class="glass-panel rounded-2xl shadow-2xl w-full max-w-md p-6 border border-white/10">
            <h3 class="text-xl font-bold text-center mb-2 text-white">Complete Payment</h3>
            <p id="payment-modal-total" class="text-4xl font-bold text-center text-emerald-400 mb-6 text-shadow-glow">৳0
            </p>
            <form id="payment-form" class="space-y-4">
                <div class="space-y-2">
                    <label
                        class="flex items-center p-4 border border-white/10 rounded-lg cursor-pointer bg-white/5 hover:bg-white/10 transition-colors has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-500/10">
                        <input type="radio" name="payment-method" value="Cash" checked
                            class="text-emerald-500 focus:ring-emerald-500 bg-gray-900 border-gray-600">
                        <span class="ml-2 font-medium text-gray-200">Cash</span>
                    </label>
                    <label
                        class="flex items-center p-4 border border-white/10 rounded-lg cursor-pointer bg-white/5 hover:bg-white/10 transition-colors has-[:checked]:border-red-500 has-[:checked]:bg-red-500/10">
                        <input type="radio" name="payment-method" value="Due"
                            class="text-red-500 focus:ring-red-500 bg-gray-900 border-gray-600">
                        <span class="ml-2 font-medium text-gray-200">Due (Baki)</span>
                    </label>
                </div>
                <div class="flex gap-2 pt-4">
                    <button type="button" onclick="printInvoice()"
                        class="flex-none bg-gray-800 text-gray-300 border border-white/10 px-4 rounded-lg font-medium shadow hover:bg-gray-700 hover:text-white transition-colors"
                        title="Print Invoice / Receipt">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z">
                            </path>
                        </svg>
                    </button>
                    <button type="button"
                        class="close-modal flex-1 bg-white/10 border border-white/5 text-gray-300 hover:text-white py-3 rounded-lg font-medium hover:bg-white/20 transition-colors">Cancel</button>
                    <button type="submit"
                        class="flex-1 bg-gradient-to-r from-emerald-600 to-green-600 text-white py-3 rounded-lg font-bold shadow-lg shadow-emerald-900/40 hover:scale-[1.02] transition-transform">Confirm</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Dark Add Product Modal -->
    <div id="add-product-modal"
        class="modal-container hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-md p-4">
        <div class="glass-panel rounded-xl shadow-xl w-full max-w-lg p-6 border border-white/10">
            <h3 class="text-lg font-bold mb-4 text-white">New Product</h3>
            <form id="add-product-form" class="space-y-3">
                <input name="p-name" placeholder="Name"
                    class="w-full bg-gray-900/50 border border-white/10 p-3 rounded text-white focus:border-emerald-500 outline-none"
                    required>
                <div class="grid grid-cols-2 gap-3"><input name="p-cat" placeholder="Category"
                        class="bg-gray-900/50 border border-white/10 p-3 rounded text-white focus:border-emerald-500 outline-none"><input
                        name="p-comp" placeholder="Company"
                        class="bg-gray-900/50 border border-white/10 p-3 rounded text-white focus:border-emerald-500 outline-none">
                </div>
                <div class="grid grid-cols-3 gap-3"><input name="p-unit" placeholder="Unit"
                        class="bg-gray-900/50 border border-white/10 p-3 rounded text-white focus:border-emerald-500 outline-none"><input
                        name="p-price" type="number" placeholder="Price"
                        class="bg-gray-900/50 border border-white/10 p-3 rounded text-white focus:border-emerald-500 outline-none"
                        required><input name="p-cost" type="number" placeholder="Cost"
                        class="bg-gray-900/50 border border-white/10 p-3 rounded text-white focus:border-emerald-500 outline-none"
                        required></div>
                <input name="p-stock" type="number" placeholder="Stock"
                    class="w-full bg-gray-900/50 border border-white/10 p-3 rounded text-white focus:border-emerald-500 outline-none"
                    required>
                <div class="flex justify-end gap-2 mt-4"><button type="button"
                        class="close-modal px-4 py-3 bg-white/10 text-gray-300 rounded hover:bg-white/20 transition-colors">Cancel</button><button
                        type="submit"
                        class="px-4 py-3 bg-emerald-600 text-white rounded hover:bg-emerald-500 shadow-lg shadow-emerald-900/40">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Dark Add Customer Modal -->
    <div id="add-customer-modal"
        class="modal-container hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-md p-4">
        <div class="glass-panel rounded-xl shadow-xl w-full max-w-md p-6 border border-white/10">
            <h3 class="text-lg font-bold mb-4 text-white">New Customer</h3>
            <form id="add-customer-form" class="space-y-3">
                <input name="c-name" placeholder="Name"
                    class="w-full bg-gray-900/50 border border-white/10 p-3 rounded text-white focus:border-emerald-500 outline-none"
                    required>
                <input name="c-phone" placeholder="Phone"
                    class="w-full bg-gray-900/50 border border-white/10 p-3 rounded text-white focus:border-emerald-500 outline-none"
                    required>
                <input name="c-email" placeholder="Email (Optional)"
                    class="w-full bg-gray-900/50 border border-white/10 p-3 rounded text-white focus:border-emerald-500 outline-none">
                <div class="flex justify-end gap-2 mt-4"><button type="button"
                        class="close-modal px-4 py-3 bg-white/10 text-gray-300 rounded hover:bg-white/20 transition-colors">Cancel</button><button
                        type="submit"
                        class="px-4 py-3 bg-emerald-600 text-white rounded hover:bg-emerald-500 shadow-lg shadow-emerald-900/40">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Dark Customer Profile Modal -->
    <div id="customer-profile-modal"
        class="modal-container hidden fixed inset-0 z-50 items-center justify-center bg-black/80 backdrop-blur-md p-4">
        <div
            class="glass-panel rounded-2xl shadow-2xl w-full max-w-2xl flex flex-col max-h-[90vh] border border-white/10">
            <div
                class="p-6 border-b border-white/10 bg-white/5 rounded-t-2xl flex justify-between items-center backdrop-blur-md">
                <div>
                    <h3 class="text-2xl font-bold text-white tracking-tight" id="profile-name">Customer Name</h3>
                    <p class="text-sm text-gray-400" id="profile-phone">Phone Number</p>
                </div>
                <button class="close-modal text-gray-400 hover:text-red-400 text-2xl transition-colors">&times;</button>
            </div>

            <div class="p-6 overflow-y-auto custom-scrollbar">
                <div class="grid grid-cols-3 gap-4 mb-6">
                    <div
                        class="glass-card p-4 rounded-xl border border-blue-500/20 text-center shadow-lg hover:bg-blue-500/10 transition-colors">
                        <p class="text-[10px] text-blue-400 font-bold uppercase tracking-wider">Total Bought</p>
                        <p class="text-2xl font-extrabold text-blue-400 mt-1" id="profile-total-buy">৳0</p>
                    </div>
                    <div
                        class="glass-card p-4 rounded-xl border border-emerald-500/20 text-center shadow-lg hover:bg-emerald-500/10 transition-colors">
                        <p class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider">Total Paid</p>
                        <p class="text-2xl font-extrabold text-emerald-400 mt-1" id="profile-total-paid">৳0</p>
                    </div>
                    <div
                        class="glass-card p-4 rounded-xl border border-red-500/20 text-center shadow-lg hover:bg-red-500/10 transition-colors">
                        <p class="text-[10px] text-red-400 font-bold uppercase tracking-wider">Current Due</p>
                        <p class="text-2xl font-extrabold text-red-400 mt-1" id="profile-total-due">৳0</p>
                    </div>
                </div>

                <!-- Manual Transaction Form -->
                <div class="glass-card p-5 rounded-xl border border-white/5 shadow-sm mb-6 bg-white/5">
                    <h4 class="font-bold text-gray-200 mb-3 flex items-center gap-2">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                        </svg>
                        Add Payment (Joma)
                    </h4>
                    <div class="flex flex-col gap-3">
                        <div>
                            <label class="text-xs font-semibold text-gray-400 uppercase">Date</label>
                            <input type="date" id="manual-date"
                                class="w-full px-3 py-2 border border-white/10 rounded-lg text-sm bg-gray-900/50 text-white focus:border-emerald-500 outline-none">
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-gray-400 uppercase">Paid Amount (Joma)</label>
                            <div class="relative">
                                <span class="absolute left-3 top-2.5 text-emerald-500 font-bold">৳</span>
                                <input type="number" id="manual-paid"
                                    class="w-full pl-8 pr-3 py-2 border border-white/10 rounded-lg text-sm bg-gray-900/50 text-white focus:border-emerald-500 outline-none"
                                    placeholder="Enter amount...">
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 flex justify-end">
                        <button onclick="saveManualTransaction()"
                            class="bg-gray-800 text-white px-6 py-2 rounded-lg text-sm font-bold hover:bg-black transition shadow-lg border border-white/10">
                            Deduct from Due
                        </button>
                    </div>
                </div>

                <!-- Related Khamar Details -->
                <div id="khamar-related-section"></div>

                <h4
                    class="font-bold text-gray-300 mb-3 border-b border-white/10 pb-2 mt-4 text-sm uppercase tracking-wider">
                    Transaction History</h4>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-white/5 text-gray-400 text-xs uppercase">
                            <tr>
                                <th class="p-3">Date</th>
                                <th class="p-3">Type</th>
                                <th class="p-3 text-right">Amount</th>
                                <th class="p-3 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody id="profile-history-body" class="divide-y divide-white/5 text-gray-300"></tbody>
                    </table>
                </div>
            </div>

            <div class="p-4 border-t border-white/10 bg-white/5 rounded-b-2xl text-right backdrop-blur-md">
                <button
                    class="close-modal bg-white/10 text-gray-200 border border-white/5 px-6 py-3 rounded-lg font-medium hover:bg-white/20 transition-colors">Close</button>
            </div>
        </div>
    </div>

    <div id="toast-notification"
        class="hidden fixed bottom-4 right-4 z-50 bg-emerald-600 text-white px-6 py-3 rounded-lg shadow-lg">Success
    </div>

</body>

</html>