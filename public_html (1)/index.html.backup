            <!-- Reports -->
            <a href="#" data-view="reports-view"
                class="nav-link flex items-center space-x-3 px-4 py-2.5 rounded-xl text-gray-400 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group">
                <svg class="w-5 h-5 group-hover:text-yellow-400 transition-colors" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                    </path>
                </svg>
                <span class="font-medium text-sm">Reports</span>
            </a>

            <!-- Sell -->
            <a href="#" data-view="sell-view"
                class="nav-link flex items-center space-x-3 px-4 py-2.5 rounded-xl text-gray-400 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group">
                <svg class="w-5 h-5 group-hover:text-pink-400 transition-colors" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
                    </path>
                </svg>
                <span class="font-medium text-sm">Sell</span>
            </a>

            <!-- SMS -->
            <a href="#" data-view="sms-view"
                class="nav-link flex items-center space-x-3 px-4 py-2.5 rounded-xl text-gray-400 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group">
                <svg class="w-5 h-5 group-hover:text-green-400 transition-colors" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z">
                    </path>
                </svg>
                <span class="font-medium text-sm">Sms</span>
            </a>

            <!-- Store Change -->
            <a href="#" data-view="store-change-view"
                class="nav-link flex items-center space-x-3 px-4 py-2.5 rounded-xl text-gray-400 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group text-sm">
                <svg class="w-5 h-5 group-hover:text-emerald-400 transition-colors" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                </svg>
                <span class="font-medium text-sm">Store Change</span>
            </a>

            <!-- Supplier -->
            <a href="#" data-view="supplier-view"
                class="nav-link flex items-center space-x-3 px-4 py-2.5 rounded-xl text-gray-400 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group">
                <svg class="w-5 h-5 group-hover:text-orange-400 transition-colors" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
                    </path>
                </svg>
                <span class="font-medium text-sm">Supplier</span>
            </a>

            <!-- System/Settings -->
            <a href="#" data-view="settings-view"
                class="nav-link flex items-center space-x-3 px-4 py-2.5 rounded-xl text-gray-400 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all mt-6 group text-sm">
                <svg class="w-5 h-5 group-hover:text-red-400 transition-colors" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z">
                    </path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="font-medium text-sm">System</span>
            </a>

            <!-- Transfer -->
            <a href="#" data-view="transfer-view"
                class="nav-link flex items-center space-x-3 px-4 py-2.5 rounded-xl text-gray-400 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group">
                <svg class="w-5 h-5 group-hover:text-teal-400 transition-colors" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                </svg>
                <span class="font-medium text-sm">Transfer</span>
            </a>

            <!-- User -->
            <a href="#" data-view="user-view"
                class="nav-link flex items-center space-x-3 px-4 py-2.5 rounded-xl text-gray-400 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group">
                <span class="font-medium text-sm">Employee Management</span>
            </a>
        </nav>

        <div class="p-4 border-t border-white/5">
            <button id="logout-btn"
                class="flex items-center space-x-2 text-red-400 hover:text-white transition w-full p-2 rounded-lg hover:bg-white/5 group">
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                    </path>
                </svg>
                <span class="font-medium">Logout</span>
            </button>
            <div class="mt-2 text-[10px] text-gray-500 truncate px-2 text-center font-mono" id="user-id-display">
                Connecting...</div>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-full overflow-hidden pt-16 md:pt-0">

        <div id="loading-view" class="main-view flex flex-col items-center justify-center h-full bg-gray-950 z-50">
            <div class="relative">
                <div class="w-16 h-16 border-4 border-emerald-500/30 border-t-emerald-500 rounded-full animate-spin">
                </div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-8 h-8 bg-emerald-500 rounded-full blur-xl opacity-20"></div>
                </div>
            </div>
            <p id="loading-text" class="text-gray-400 font-medium mt-6 tracking-widest text-xs uppercase">Initializing
                System...</p>
        </div>

        <div id="login-view"
            class="main-view hidden flex items-center justify-center h-full bg-gray-950 p-4 relative overflow-hidden">
            <!-- Background Decoration -->
            <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0">
                <div class="absolute -top-40 -right-40 w-96 h-96 bg-purple-600/20 rounded-full blur-[100px]"></div>
                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-emerald-600/10 rounded-full blur-[120px]">
                </div>
            </div>

            <div class="w-full max-w-md glass-panel p-8 rounded-2xl shadow-2xl relative z-10 border border-white/10">
                <div class="text-center mb-10">
                    <h2
                        class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400 mb-2">
                        AKHI POULTRY FARM 2.0</h2>
                    <p class="text-gray-500 text-xs tracking-[0.2em] uppercase">Secure Access Terminal</p>
                </div>
                <form id="admin-login-form" class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Access Password</label>
                        <input type="password" id="admin-password"
                            class="input-field bg-gray-900/50 border-white/10 focus:border-emerald-500 text-center tracking-widest text-white"
                            placeholder="••••••••••••••">
                    </div>
                    <button type="submit"
                        class="w-full bg-gradient-to-r from-emerald-600 to-green-600 text-white font-bold py-3.5 rounded-xl hover:shadow-lg hover:shadow-emerald-900/50 transition-all transform active:scale-95 border border-white/10">
                        UNLOCK SYSTEM
                    </button>
                </form>
            </div>
        </div>

        <div id="pos-view" class="main-view hidden h-full overflow-y-auto md:overflow-hidden flex flex-col md:flex-row">
            <section class="flex-1 p-4 md:p-6 flex flex-col h-[65vh] md:h-full overflow-hidden order-1 shrink-0">
                <div class="mb-4">
                    <div class="relative">
                        <input type="text" id="product-search" placeholder="Search item..."
                            class="input-field pl-10 pr-4 py-3 bg-gray-900/50 border-white/10 text-white placeholder-gray-500 focus:ring-emerald-500/50">
                        <svg class="w-5 h-5 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                </div>
                <!-- Gradients for scroll fade -->
                <div id="product-grid"
                    class="flex-1 overflow-y-auto grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 pb-20 md:pb-0 pr-2">
                </div>
            </section>

            <section
                class="w-full md:w-96 glass-panel flex flex-col min-h-[60vh] md:h-full z-30 order-2 border-t md:border-t-0 md:border-l border-white/10 shadow-2xl shrink-0">
                <div class="p-4 border-b border-white/10 bg-white/5 flex justify-between items-center backdrop-blur-md">
                    <h2 class="text-lg font-bold text-white tracking-wide">Customer Bill</h2>
                    <button id="clear-cart-btn"
                        class="text-xs text-red-400 hover:text-red-300 hover:underline transition">Clear Cart</button>
                </div>

                <div class="px-4 pt-4 pb-2 relative">
                    <label
                        class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-2">Customer</label>
                    <div class="relative">
                        <input type="text" id="customer-search-input" placeholder="Search customer..."
                            class="w-full bg-gray-900/50 border border-white/10 rounded-xl px-3 py-3 text-sm text-white focus:ring-2 focus:ring-emerald-500/50 outline-none transition-all"
                            placeholder="Search customer..." autocomplete="off">
                        <input type="hidden" id="cart-customer-id" value="walk-in">
                        <div id="customer-search-results"
                            class="hidden absolute top-full left-0 w-full bg-gray-800 border border-white/10 shadow-xl rounded-b-xl max-h-48 overflow-y-auto z-50">
                        </div>
                    </div>
                </div>

                <div id="cart-items" class="flex-1 overflow-y-auto p-4 space-y-3"></div>

                <div class="p-4 pb-8 md:pb-4 bg-gray-900/80 border-t border-white/5 space-y-3 backdrop-blur-md">
                    <div class="flex justify-between text-sm text-gray-400"><span>Subtotal</span><span
                            id="cart-subtotal" class="font-bold text-white">৳0</span></div>
                    <div class="flex justify-between items-center text-sm text-gray-400"><span>Discount</span><input
                            type="number" id="cart-discount"
                            class="w-20 text-right bg-gray-800 border border-white/10 rounded px-1 py-1 text-sm text-white outline-none focus:border-emerald-500"
                            placeholder="0">
                    </div>
                    <div class="flex justify-between text-xl font-bold text-white pt-3 border-t border-white/10">
                        <span>Total Pay</span><span id="cart-total" class="text-emerald-400">৳0</span>
                    </div>
                    <button id="charge-btn"
                        class="w-full bg-gradient-to-r from-green-500 to-emerald-600 text-white font-bold py-4 rounded-xl shadow-lg shadow-emerald-900/50 hover:scale-[1.02] transition-all disabled:opacity-50 disabled:cursor-not-allowed btn-touch tracking-wider">
                        CHARGE / PRINT
                    </button>
                </div>
            </section>
        </div>

        <div id="dashboard-view" class="main-view hidden h-full overflow-y-auto p-4 md:p-8">
            <h2
                class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400 mb-8">
                Dashboard Overview</h2>

            <!-- Quick Alerts -->
            <div id="inventory-alerts" class="mb-6 space-y-2"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
                    <div
                        class="absolute -right-4 -top-4 w-24 h-24 bg-emerald-500/10 rounded-full blur-xl group-hover:bg-emerald-500/20 transition-all">
                    </div>
                    <p class="text-xs text-gray-400 uppercase font-bold tracking-wider">Total Revenue</p>
                    <p id="stat-revenue" class="text-3xl font-bold text-emerald-400 mt-2 text-shadow-glow">৳0</p>
                </div>
                <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
                    <div
                        class="absolute -right-4 -top-4 w-24 h-24 bg-blue-500/10 rounded-full blur-xl group-hover:bg-blue-500/20 transition-all">
                    </div>
                    <p class="text-xs text-gray-400 uppercase font-bold tracking-wider">Sales Count</p>
                    <p id="stat-sales" class="text-3xl font-bold text-blue-400 mt-2">0</p>
                </div>
                <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
                    <div
                        class="absolute -right-4 -top-4 w-24 h-24 bg-purple-500/10 rounded-full blur-xl group-hover:bg-purple-500/20 transition-all">
                    </div>
                    <p class="text-xs text-gray-400 uppercase font-bold tracking-wider">Inventory Items</p>
                    <p id="stat-products" class="text-3xl font-bold text-purple-400 mt-2">0</p>
                </div>
                <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
                    <div
                        class="absolute -right-4 -top-4 w-24 h-24 bg-orange-500/10 rounded-full blur-xl group-hover:bg-orange-500/20 transition-all">
                    </div>
                    <p class="text-xs text-gray-400 uppercase font-bold tracking-wider">Customers</p>
                    <p id="stat-customers" class="text-3xl font-bold text-orange-400 mt-2">0</p>
                </div>
            </div>

            <!-- Advanced Analytics Section -->
            <div class="glass-card p-6 rounded-2xl mb-8">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="font-bold text-gray-200 text-lg">Financial Overview</h3>
                    <div class="flex gap-2">
                        <select id="chart-period"
                            class="bg-gray-800 border border-white/10 rounded-lg px-3 py-1 text-xs text-white outline-none focus:border-emerald-500">
                            <option value="7">Last 7 Days</option>
                            <option value="30" selected>Last 30 Days</option>
                            <option value="365">This Year</option>
                        </select>
                    </div>
                </div>
                <div class="h-80 w-full">
                    <canvas id="financialChart"></canvas>
                </div>
            </div>

            <div class="flex flex-col md:flex-row gap-6">
                <div class="flex-1 glass-card p-6 rounded-2xl">
                    <h3 class="font-bold text-gray-200 mb-4 tracking-wide border-b border-white/10 pb-2">Top Products
                    </h3>
                    <div
                        class="flex justify-between items-center mb-2 text-[10px] text-gray-500 uppercase tracking-widest font-bold">
                        <span>Name</span><span>Qty</span><span>Rev</span>
                    </div>
                    <div class="overflow-y-auto max-h-64 scrollbar-thin">
                        <table class="w-full text-sm text-left">
                            <tbody id="product-sales-report-table-body"></tbody>
                        </table>
                    </div>
                    <div class="mt-4 pt-4 border-t border-white/10 text-sm font-bold text-right text-gray-400">Total
                        Units: <span id="total-items-sold-stat" class="text-white">0</span></div>
                </div>
                <div class="flex-1 glass-card p-6 rounded-2xl">
                    <h3 class="font-bold text-gray-200 mb-4 tracking-wide border-b border-white/10 pb-2">Customer Due
                        List</h3>
                    <div
                        class="flex justify-between items-center mb-2 text-[10px] text-gray-500 uppercase tracking-widest font-bold">
                        <span>Name</span><span>Due</span>
                    </div>
                    <div class="overflow-y-auto max-h-64 scrollbar-thin">
                        <table class="w-full text-sm text-left">
                            <tbody id="customer-ledger-table-body"></tbody>
                        </table>
                    </div>
                    <div class="mt-4 pt-4 border-t border-white/10 text-sm font-bold text-right text-red-400">Total Due:
                        <span id="total-due-stat" class="text-red-500">৳0</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- UPDATED PURCHASE VIEW: Dark Glass -->
        <div id="purchase-view" class="main-view hidden h-full flex flex-col p-4 md:p-8 overflow-y-auto">
            <h2
                class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400 mb-6 sticky top-0 z-10 py-2 flex items-center gap-2 backdrop-blur-md">
                <span>Feed & Stock Purchase</span>
                <span
                    class="text-xs font-normal text-gray-400 border border-white/10 px-2 py-1 rounded-full bg-white/5">Supports
                    Broiler & Sonali (Pcs)</span>
            </h2>

            <!-- Summary Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
                <div class="glass-card p-5 rounded-2xl relative overflow-hidden group">
                    <div class="absolute -right-4 -top-4 w-20 h-20 bg-gray-500/20 rounded-full blur-xl"></div>
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Total Purchase Cost</p>
                    <p id="ledger-total-cost" class="text-3xl font-extrabold text-white mt-2">৳0</p>
                </div>
                <div class="glass-card p-5 rounded-2xl relative overflow-hidden group border-emerald-500/30">
                    <div class="absolute -right-4 -top-4 w-20 h-20 bg-emerald-500/20 rounded-full blur-xl"></div>
                    <p class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Total Paid (Joma)</p>
                    <p id="ledger-total-paid" class="text-3xl font-extrabold text-emerald-400 mt-2">৳0</p>
                </div>
                <div class="glass-card p-5 rounded-2xl relative overflow-hidden group border-red-500/30">
                    <div class="absolute -right-4 -top-4 w-20 h-20 bg-red-500/20 rounded-full blur-xl"></div>
                    <p class="text-xs font-bold text-red-400 uppercase tracking-wider">Total Due (Baki)</p>
                    <p id="ledger-total-due" class="text-3xl font-extrabold text-red-400 mt-2">৳0</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- INPUT FORM (Left Column) -->
                <div class="lg:col-span-4 space-y-4">
                    <div class="glass-panel p-6 rounded-2xl sticky top-24">
                        <div class="flex items-center gap-2 mb-6 border-b border-white/10 pb-3">
                            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 4v16m8-8H4"></path>
                            </svg>
                            <h3 class="font-bold text-white tracking-wide">New Purchase Entry</h3>
                        </div>

                        <form id="purchase-form" class="space-y-4" onsubmit="event.preventDefault();">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <div>
                                    <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Date</label>
                                    <input type="date" id="purchase-entry-date" class="input-field py-2 text-sm">
                                </div>
                                <div>
                                    <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Type</label>
                                    <select id="purchase-type" class="input-field bg-gray-900/50 py-2 text-sm">
                                        <option value="Feed" class="text-gray-900">Feed</option>
                                        <option value="Broiler" class="text-gray-900">Broiler (Pcs)</option>
                                        <option value="Sonali" class="text-gray-900">Sonali (Pcs)</option>
                                        <option value="Gura" class="text-gray-900">Gura</option>
                                        <option value="Medicine" class="text-gray-900">Medicine</option>
                                        <option value="Other" class="text-gray-900">Other</option>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Item Name</label>
                                <div class="relative">
                                    <input type="text" id="purchase-item-name"
                                        class="input-field font-bold py-3 text-white" placeholder="e.g. Broiler Starter"
                                        autocomplete="off">
                                    <!-- Smart Suggestions Dropdown -->
                                    <div id="purchase-item-results"
                                        class="hidden absolute top-full left-0 w-full bg-gray-800 border border-white/10 shadow-xl rounded-b-lg max-h-48 overflow-y-auto z-50">
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Supplier</label>
                                <div class="relative">
                                    <input type="text" id="purchase-supplier" class="input-field text-sm py-3"
                                        placeholder="Company Name" autocomplete="off">
                                    <div id="purchase-supplier-results"
                                        class="hidden absolute top-full left-0 w-full bg-gray-800 border border-white/10 shadow-xl rounded-b-lg max-h-48 overflow-y-auto z-50">
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <div>
                                    <label id="lbl-unit"
                                        class="text-xs font-bold text-gray-500 uppercase mb-1 block">Qty (Bags)</label>
                                    <input type="number" id="purchase-qty"
                                        class="input-field bg-yellow-500/10 border-yellow-500/30 text-yellow-400 font-bold py-3 placeholder-yellow-500/50"
                                        placeholder="0">
                                </div>
                                <div>
                                    <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Buy Rate</label>
                                    <input type="number" id="purchase-buy-rate" class="input-field py-3"
                                        placeholder="Cost/unit">
                                </div>
                            </div>

                            <div>
                                <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Update Sell Rate
                                    (Optional)</label>
                                <input type="number" id="purchase-sell-rate" class="input-field py-3"
                                    placeholder="Selling Price">
                            </div>

                            <div class="bg-gray-800/50 p-4 rounded-xl border border-dashed border-white/10 mt-4">
                                <div class="flex justify-between mb-3">
                                    <span class="text-xs text-gray-400 font-bold uppercase">Total Bill</span>
                                    <input id="purchase-total-bill"
                                        class="text-right bg-transparent font-bold text-white outline-none w-24"
                                        readonly value="0">
                                </div>
                                <div class="flex justify-between items-center mb-3">
                                    <span class="text-xs text-emerald-400 font-bold uppercase">Paid (Joma)</span>
                                    <input type="number" id="purchase-paid"
                                        class="input-field w-24 py-1 px-2 text-right text-emerald-400 border-emerald-500/30 focus:border-emerald-500 h-8"
                                        placeholder="0">
                                </div>
                                <div class="flex justify-between border-t border-white/10 pt-3">
                                    <span class="text-xs text-red-400 font-bold uppercase">Due</span>
                                    <span id="purchase-current-due" class="font-bold text-red-400 text-lg">৳0</span>
                                </div>
                            </div>

                            <button id="btn-save-purchase"
                                class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl py-4 text-sm font-bold shadow-lg shadow-blue-900/40 hover:scale-[1.02] transition-all flex items-center justify-center gap-2 btn-touch tracking-wider">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4">
                                    </path>
                                </svg>
                                SAVE RECORD
                            </button>
                        </form>
                    </div>
                </div>

                <!-- SAVED RECORDS (Right Column) -->
                <div class="lg:col-span-8 flex flex-col gap-4">
                    <!-- Filters -->
                    <div class="glass-card p-4 rounded-xl flex flex-wrap gap-3 items-center justify-between">
                        <div class="flex gap-2 items-center text-gray-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z">
                                </path>
                            </svg>
                            <span class="text-xs font-bold uppercase">Filter:</span>
                        </div>
                        <div class="flex gap-2 items-center flex-1 overflow-x-auto">
                            <input type="date" id="purchase-date-start"
                                class="input-field py-1 px-2 text-xs w-32 border-white/5 bg-gray-900/50">
                            <span class="text-gray-500">-</span>
                            <input type="date" id="purchase-date-end"
                                class="input-field py-1 px-2 text-xs w-32 border-white/5 bg-gray-900/50">
                            <button id="btn-filter-purchase"
                                class="bg-blue-600/20 text-blue-400 border border-blue-500/30 px-3 py-1 rounded-lg text-xs font-bold hover:bg-blue-600 hover:text-white transition-colors">APPLY</button>
                            <button id="btn-reset-purchase"
                                class="bg-white/5 text-gray-400 border border-white/10 px-3 py-1 rounded-lg text-xs font-bold hover:bg-white/10 hover:text-white transition-colors">RESET</button>
                        </div>
                    </div>

                    <!-- DESKTOP TABLE -->
                    <div class="glass-card rounded-2xl overflow-hidden hidden md:block flex-1 flex flex-col">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left whitespace-nowrap">
                                <thead class="bg-white/5 border-b border-white/10 text-gray-400">
                                    <tr>
                                        <th class="p-4 text-xs font-bold uppercase tracking-wider">Date</th>
                                        <th class="p-4 text-xs font-bold uppercase tracking-wider">Item Details</th>
                                        <th class="p-4 text-center text-xs font-bold uppercase tracking-wider">Qty</th>
                                        <th class="p-4 text-right text-xs font-bold uppercase tracking-wider">Rate</th>
                                        <th class="p-4 text-right text-xs font-bold uppercase tracking-wider">Total</th>
                                        <th class="p-4 text-right text-xs font-bold uppercase tracking-wider">Paid</th>
                                        <th class="p-4 text-right text-xs font-bold uppercase tracking-wider">Status
                                        </th>
                                        <th class="p-4 text-center text-xs font-bold uppercase tracking-wider">Stock
                                        </th>
                                        <th class="p-4 text-right text-xs font-bold uppercase tracking-wider">Action
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="purchase-table-body" class="divide-y divide-white/5 text-sm"></tbody>
                            </table>
                        </div>
                    </div>

                    <!-- MOBILE CARDS -->
                    <div id="purchase-card-list" class="md:hidden space-y-3 pb-20"></div>
                </div>
            </div>
        </div>

        <div id="inventory-view" class="main-view hidden h-full flex flex-col p-4 md:p-8">
            <div class="flex justify-between items-center mb-6">
                <h2
                    class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">
                    Inventory Management</h2>
                <button id="add-product-btn"
                    class="bg-gradient-to-r from-purple-600 to-pink-600 text-white px-6 py-3 rounded-xl text-sm font-bold shadow-lg shadow-purple-900/40 hover:scale-[1.02] transition-transform btn-touch">+
                    Add Product</button>
            </div>

            <div class="flex-1 glass-card rounded-2xl overflow-hidden flex flex-col border border-white/5">
                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left whitespace-nowrap">
                        <thead class="bg-white/5 border-b border-white/10 text-gray-400">
                            <tr>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">Product</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">Unit</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">Price</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">Stock</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="inventory-table-body" class="divide-y divide-white/5 text-sm"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="reports-view" class="main-view hidden h-full flex flex-col p-4 md:p-8">
            <div class="flex justify-between items-center mb-6">
                <h2
                    class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-orange-400">
                    Sales History & Reports</h2>
                <button id="btn-download-report"
                    class="bg-gradient-to-r from-emerald-600 to-green-600 text-white px-5 py-3 rounded-xl text-sm font-bold shadow-lg shadow-emerald-900/40 hover:scale-[1.02] flex items-center gap-2 transition-transform">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    Download PDF
                </button>
            </div>

            <div class="glass-card p-4 rounded-xl mb-6 flex flex-wrap gap-4 items-end border border-white/5">
                <div><label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1">Start
                        Date</label><input type="date" id="report-date-start"
                        class="input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10"></div>
                <div><label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1">End
                        Date</label><input type="date" id="report-date-end"
                        class="input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10"></div>
                <div class="flex-1"><label
                        class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1">Customer
                        Search</label><input type="text" id="report-customer-filter" placeholder="Filter by Name..."
                        class="input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10 w-full"></div>
                <div class="flex gap-2 h-10">
                    <button id="btn-filter-reports"
                        class="bg-blue-600/80 text-white px-6 rounded-xl text-sm font-bold hover:bg-blue-600 transition-colors">Apply
                        Filter</button>
                    <button id="btn-reset-reports"
                        class="bg-white/5 text-gray-400 px-4 rounded-xl text-sm font-bold hover:bg-white/10 hover:text-white transition-colors">Reset</button>
                </div>
            </div>

            <div class="flex-1 glass-card rounded-2xl overflow-hidden flex flex-col border border-white/5">
                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left whitespace-nowrap">
                        <thead class="bg-white/5 border-b border-white/10 text-gray-400">
                            <tr>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">ID</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">Date</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">Customer</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">Total</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">Status</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">Action</th>
                            </tr>
                        </thead>
                        <tbody id="reports-table-body" class="divide-y divide-white/5 text-sm"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="customers-view" class="main-view hidden h-full flex flex-col p-4 md:p-8">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-rose-400">
                    Customer Directory</h2>
                <button id="add-customer-btn"
                    class="bg-gradient-to-r from-pink-600 to-rose-600 text-white px-6 py-3 rounded-xl text-sm font-bold shadow-lg shadow-pink-900/40 hover:scale-[1.02] transition-transform">+
                    New Customer</button>
            </div>
            <div class="mb-6 relative">
                <input type="text" id="customer-search" class="input-field pl-12 py-3 bg-gray-900/50 border-white/10"
                    placeholder="Search by name or phone...">
                <svg class="w-5 h-5 text-gray-500 absolute left-4 top-1/2 -translate-y-1/2" fill="none"
                    stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>

            <div class="flex-1 glass-card rounded-2xl overflow-hidden flex flex-col border border-white/5">
                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left whitespace-nowrap">
                        <thead class="bg-white/5 border-b border-white/10 text-gray-400">
                            <tr>
                                <th class="p-4 text-xs font-bold uppercase tracking-wider">Name</th>
                                <th class="p-4 text-xs font-bold uppercase tracking-wider">Phone</th>
                                <th class="p-4 text-xs font-bold uppercase tracking-wider text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody id="customers-table-body" class="divide-y divide-white/5 text-sm"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="khamar-view" class="main-view hidden h-full overflow-y-auto p-4 md:p-8">
            <h2
                class="text-2xl font-bold mb-6 text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-400">
                Khamar Manager</h2>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <!-- FARMS LIST SIDEBAR -->
                <div class="glass-card p-4 rounded-xl h-fit border border-white/5">
                    <h3 class="font-bold text-gray-400 mb-3 text-sm uppercase tracking-wider">Farms</h3>
                    <div class="mb-3">
                        <input id="khamar-search-input" type="text"
                            class="w-full input-field py-1.5 px-3 text-sm bg-gray-900/50 border-white/10"
                            placeholder="Search Farm...">
                    </div>
                    <div class="flex gap-2 mb-4">
                        <input id="khamar-name-input"
                            class="input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10"
                            placeholder="New Farm Name">
                        <button id="btn-add-khamar"
                            class="bg-orange-600 text-white px-3 py-2 rounded-lg text-sm font-bold shadow-lg shadow-orange-900/20 hover:bg-orange-700">Add</button>
                    </div>
                    <div id="khamar-list" class="space-y-2"></div>
                </div>

                <!-- MAIN CONTENT AREA -->
                <div class="md:col-span-3 space-y-6">
                    <!-- TABS -->
                    <div class="flex space-x-2 border-b border-white/10 pb-1 overflow-x-auto">
                        <button id="tab-sales"
                            class="tab-active px-6 py-3 rounded-t-lg font-bold text-sm transition-all whitespace-nowrap border-b-2 border-orange-500 text-orange-400 bg-white/5">Chicken
                            Sales</button>
                        <button id="tab-feed"
                            class="tab-inactive px-6 py-3 rounded-t-lg font-bold text-sm transition-all whitespace-nowrap text-gray-400 hover:text-white">Feed/Gura
                            Distribution</button>
                    </div>

                    <!-- FILTERS -->
                    <div class="glass-card p-4 rounded-lg flex flex-wrap gap-3 items-end border border-white/5">
                        <div><label
                                class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1">Start</label><input
                                type="date" id="khamar-date-start"
                                class="input-field py-1 px-2 text-xs bg-gray-900/50 border-white/10"></div>
                        <div><label
                                class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1">End</label><input
                                type="date" id="khamar-date-end"
                                class="input-field py-1 px-2 text-xs bg-gray-900/50 border-white/10"></div>
                        <button id="btn-filter-khamar"
                            class="bg-blue-600/20 text-blue-400 border border-blue-500/30 px-4 py-2 rounded-lg text-xs font-bold hover:bg-blue-600 hover:text-white transition-colors">Filter</button>
                        <button id="btn-reset-khamar"
                            class="bg-white/5 text-gray-400 px-4 py-2 rounded-lg text-xs font-bold hover:bg-white/10 hover:text-white">Reset</button>
                    </div>

                    <!-- CHICKEN SALES SECTION -->
                    <div id="section-sales">
                        <div class="glass-panel p-6 rounded-xl mb-6 relative border border-white/5">
                            <div
                                class="absolute top-0 right-0 w-32 h-32 bg-orange-500/5 rounded-full blur-3xl pointer-events-none">
                            </div>
                            <h3
                                class="font-bold text-white mb-4 text-sm uppercase tracking-wider border-b border-white/10 pb-2">
                                New Sale Entry</h3>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                <input type="date" id="sale-date"
                                    class="input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10"
                                    title="Leave empty for today">

                                <select id="sale-khamar-select"
                                    class="input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10 text-gray-300">
                                    <option class="text-gray-900">Select Farm</option>
                                </select>

                                <div class="relative">
                                    <input id="sale-buyer-name"
                                        class="input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10"
                                        placeholder="Buyer Name" autocomplete="off">
                                    <div id="sale-buyer-results"
                                        class="hidden absolute top-full left-0 w-full bg-gray-800 border border-white/10 shadow-lg rounded-b-lg max-h-48 overflow-y-auto z-50">
                                    </div>
                                </div>

                                <select id="sale-breed-select"
                                    class="input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10 text-gray-300">
                                    <option value="Broiler" class="text-gray-900">Broiler</option>
                                    <option value="Sonali" class="text-gray-900">Sonali</option>
                                    <option value="Layer" class="text-gray-900">Layer</option>
                                    <option value="Deshi" class="text-gray-900">Deshi</option>
                                </select>
                                <input id="sale-quantity" type="number"
                                    class="input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10"
                                    placeholder="Quantity (Pcs)">
                                <input id="sale-weight" type="number"
                                    class="input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10"
                                    placeholder="Weight (kg)">
                                <input id="sale-rate" type="number"
                                    class="input-field py-2 px-3 text-sm bg-gray-900/50 border-white/10"
                                    placeholder="Rate">
                                <input id="sale-total-amount"
                                    class="input-field py-2 px-3 text-sm bg-white/5 border-white/10 font-bold text-white text-right"
                                    readonly placeholder="Total">
                                <input id="sale-paid-amount" type="number"
                                    class="input-field py-2 px-3 text-sm bg-emerald-500/10 border-emerald-500/30 text-emerald-400 font-bold text-right placeholder-emerald-500/50"
                                    placeholder="Paid (Joma)">
                            </div>
                            <div class="mt-6 flex justify-between items-center border-t border-white/10 pt-4">
                                <span id="sale-due-amount" class="font-bold text-red-400 text-lg">Due: ৳0.00</span>
                                <button id="btn-record-sale"
                                    class="bg-gradient-to-r from-emerald-600 to-green-600 text-white rounded-xl px-8 py-3 text-sm font-bold shadow-lg shadow-emerald-900/40 hover:scale-[1.02] transition-transform">SAVE
                                    SALE</button>
                            </div>
                        </div>

                        <div id="chicken-sales-card"
                            class="glass-card rounded-xl overflow-hidden border border-white/5 relative transition-all duration-300">
                            <div
                                class="px-6 py-4 border-b border-white/10 bg-white/5 flex justify-between items-center sticky top-0 z-20 backdrop-blur-md">
                                <div id="chicken-sales-stats-container" class="flex-1">
                                    <h3 class="font-bold text-gray-400 text-xs uppercase tracking-wider">Sales Records
                                    </h3>
                                </div>
                                <button onclick="toggleSalesFullscreen()"
                                    class="ml-4 text-gray-400 hover:text-white transition-colors p-2 hover:bg-white/5 rounded-lg">
                                    <svg id="icon-maximize" class="w-5 h-5" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4">
                                        </path>
                                    </svg>
                                    <svg id="icon-minimize" class="w-5 h-5 hidden" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </div>
                            <div class="hidden md:block overflow-x-auto">
                                <table class="w-full text-left whitespace-nowrap">
                                    <thead class="bg-white/5 border-b border-white/10 text-gray-400">
                                        <tr>
                                            <th class="p-3 text-xs font-bold uppercase tracking-wider">Date</th>
                                            <th class="p-3 text-xs font-bold uppercase tracking-wider">Farm</th>
                                            <th class="p-3 text-xs font-bold uppercase tracking-wider">Buyer</th>
                                            <th class="p-3 text-xs font-bold uppercase tracking-wider">Qty</th>
                                            <th class="p-3 text-xs font-bold uppercase tracking-wider">Weight</th>
                                            <th class="p-3 text-xs font-bold uppercase tracking-wider">Rate</th>
                                            <th class="p-3 text-xs font-bold uppercase tracking-wider">Total</th>
                                            <th class="p-3"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="chicken-sales-table-body"
                                        class="divide-y divide-white/5 text-sm text-gray-300"></tbody>
                                </table>
                            </div>
                            <div id="chicken-sales-mobile-list" class="md:hidden space-y-3 p-4"></div>
                        </div>
                    </div>

                    <!-- FEED DISTRIBUTION SECTION -->
                    <div id="section-feed" class="hidden">
                        <!-- Stats Cards -->
                        <div class="flex md:grid md:grid-cols-3 gap-4 mb-6 overflow-x-auto pb-2 md:pb-0">
                            <div class="glass-card p-5 rounded-2xl min-w-[200px] border-orange-500/20">
                                <p class="text-xs font-bold text-orange-400 uppercase tracking-wider">Total Supply
                                    Cost
                                </p>
                                <p id="feed-ledger-total-cost" class="text-2xl font-extrabold text-white mt-2">৳0
                                </p>
                            </div>
                            <div class="glass-card p-5 rounded-2xl min-w-[200px] border-emerald-500/20">
                                <p class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Total Paid
                                    (Joma)
                                </p>
                                <p id="feed-ledger-total-paid" class="text-2xl font-extrabold text-emerald-400 mt-2">৳0
                                </p>
                            </div>
                            <div class="glass-card p-5 rounded-2xl min-w-[200px] border-red-500/20">
                                <p class="text-xs font-bold text-red-400 uppercase tracking-wider">Total Due (Baki)
                                </p>
                                <p id="feed-ledger-total-due" class="text-2xl font-extrabold text-red-400 mt-2">৳0
                                </p>
                            </div>
                        </div>

                        <!-- Supply Entry Form -->
                        <div class="glass-panel p-6 rounded-xl mb-6 border border-white/5">
                            <h3
                                class="font-bold text-white mb-4 text-sm uppercase tracking-wider border-b border-white/10 pb-2">
                                Supply to Khamar</h3>

                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end mb-6">
                                <div class="w-full">
                                    <label
                                        class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mb-1 block">Select
                                        Khamar</label>
                                    <select id="feed-khamar-select"
                                        class="input-field w-full py-2 px-3 text-sm bg-gray-900/50 border-white/10 text-gray-300">
                                        <option class="text-gray-900">Select Farm</option>
                                    </select>
                                </div>
                                <div>
                                    <label
                                        class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mb-1 block">Feed
                                        (Bags)</label>
                                    <input id="feed-qty" type="number"
                                        class="input-field w-full py-2 px-3 text-sm bg-gray-900/50 border-white/10"
                                        placeholder="0">
                                </div>
                                <div>
                                    <label
                                        class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mb-1 block">Gura
                                        (Bags)</label>
                                    <input id="gura-qty" type="number"
                                        class="input-field w-full py-2 px-3 text-sm bg-gray-900/50 border-white/10"
                                        placeholder="0">
                                </div>
                                <div>
                                    <label
                                        class="text-[10px] text-emerald-400 font-bold uppercase tracking-widest mb-1 block">Paid
                                        (Joma)</label>
                                    <input id="feed-paid" type="number"
                                        class="input-field w-full py-2 px-3 text-sm bg-emerald-500/10 border-emerald-500/30 text-emerald-400 font-bold placeholder-emerald-500/50"
                                        placeholder="0">
                                </div>
                            </div>

                            <!-- Cost Inputs -->
                            <div class="bg-gray-800/50 p-4 rounded-xl border border-dashed border-white/10">
                                <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                                    <div>
                                        <label class="text-[10px] text-gray-500 font-bold uppercase mb-1 block">Feed
                                            Cost</label>
                                        <input id="cost-feed" type="number"
                                            class="input-field bg-gray-900/50 border-white/10 text-sm" placeholder="0">
                                    </div>
                                    <div>
                                        <label class="text-[10px] text-gray-500 font-bold uppercase mb-1 block">Gura
                                            Cost</label>
                                        <input id="cost-gura" type="number"
                                            class="input-field bg-gray-900/50 border-white/10 text-sm" placeholder="0">
                                    </div>
                                    <div>
                                        <label class="text-[10px] text-blue-400 font-bold uppercase mb-1 block">Chicken
                                            Cost</label>
                                        <input id="cost-chicken" type="number"
                                            class="input-field bg-blue-500/10 border-blue-500/30 text-blue-400 text-sm"
                                            placeholder="0">
                                    </div>
                                    <div>
                                        <label
                                            class="text-[10px] text-orange-400 font-bold uppercase mb-1 block">Cleaning
                                            Cost</label>
                                        <input id="cost-cleaning" type="number"
                                            class="input-field bg-orange-500/10 border-orange-500/30 text-orange-400 text-sm"
                                            placeholder="0">
                                    </div>
                                    <div>
                                        <label
                                            class="text-[10px] text-purple-400 font-bold uppercase mb-1 block">Vaccine
                                            Cost</label>
                                        <input id="cost-vaccine" type="number"
                                            class="input-field bg-purple-500/10 border-purple-500/30 text-purple-400 text-sm"
                                            placeholder="0">
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <label class="text-[10px] text-gray-500 font-bold uppercase mb-1 block">Other
                                        Cost</label>
                                    <input id="cost-other" type="number"
                                        class="input-field bg-gray-900/50 border-white/10 text-sm w-full"
                                        placeholder="0">
                                </div>
                            </div>

                            <div class="mt-4 border-t border-white/10 pt-3">
                                <div class="flex justify-between items-center mb-2">
                                    <label class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Custom
                                        Fields</label>
                                    <button id="btn-add-custom-field"
                                        class="text-xs bg-white/5 px-3 py-1 rounded-lg text-blue-400 font-bold hover:bg-white/10 hover:text-white transition-colors border border-white/5">+
                                        Add Field</button>
                                </div>
                                <div id="custom-fields-container" class="space-y-2"></div>
                            </div>

                            <div
                                class="mt-6 pt-4 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4">
                                <div class="flex items-center gap-4 text-gray-400">
                                    <span class="text-sm font-bold">Total Bill: <b id="feed-display-total"
                                            class="text-lg text-white">0.00</b></span>
                                    <span id="feed-due" class="font-bold text-red-400 text-lg">Due: ৳0.00</span>
                                </div>
                                <button id="btn-record-feed"
                                    class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl px-8 py-3 text-sm font-bold hover:scale-[1.02] shadow-lg shadow-blue-900/40 transition-transform w-full md:w-auto">SAVE
                                    ENTRY</button>
                            </div>
                        </div>

                        <!-- Supply History Table -->
                        <div class="glass-card rounded-xl overflow-hidden border border-white/5 mb-6">
                            <h3
                                class="px-6 py-4 font-bold text-gray-400 text-xs uppercase tracking-wider border-b border-white/10 bg-white/5">
                                Supply History</h3>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left whitespace-nowrap">
                                    <thead class="bg-white/5 border-b border-white/10 text-gray-400 text-xs uppercase">
                                    </thead>
                                    <tbody id="feed-table-body" class="divide-y divide-white/5 text-sm text-gray-300">
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Feed Ledger Running Balance -->
                        <div class="glass-card p-4 rounded-xl border border-white/5">
                            <h3
                                class="font-bold text-gray-400 mb-3 border-b border-white/10 pb-2 text-xs uppercase tracking-wider">
                                Feed Ledger (Running Balance)</h3>
                            <div id="feed-ledger-list" class="max-h-64 overflow-y-auto custom-scrollbar"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        </div>

        <div id="settings-view" class="main-view hidden h-full p-4 md:p-8">
            <h2 class="text-2xl font-bold mb-6 text-white">Settings</h2>
            <div class="glass-card p-6 rounded-xl border border-red-500/30 max-w-2xl relative overflow-hidden">
                <div class="absolute -right-4 -top-4 w-32 h-32 bg-red-500/10 rounded-full blur-3xl pointer-events-none">
                </div>
                <h3 class="text-lg font-bold text-red-400 flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
                        </path>
                    </svg>
                    Danger Zone
                </h3>
                <p class="text-sm text-gray-400 mt-2 mb-4">Resetting business data will clear sales history and ledgers.
                    Products will remain.</p>
                <button id="btn-reset-data"
                    class="bg-red-500/10 text-red-400 border border-red-500/30 px-6 py-3 rounded-xl hover:bg-red-500/20 transition-colors font-bold text-sm w-full md:w-auto">Reset
                    Data</button>
            </div>
        </div>

        <!-- Sell View -->
        <div id="sell-view" class="main-view hidden h-full overflow-y-auto p-4 md:p-8">
            <h2
                class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400 mb-8">
                Sell List</h2>
            <div class="glass-card p-6 rounded-2xl text-center text-gray-400">
                <p>Sell module coming soon. Use POS Terminal for now.</p>
            </div>
        </div>

        <!-- Quotation View -->
        <div id="quotation-view" class="main-view hidden h-full overflow-y-auto p-4 md:p-8">
            <h2 class="text-3xl font-extrabold text-white mb-8">Quotations</h2>
            <div class="glass-card p-6 rounded-2xl mb-6">
                <div class="flex flex-wrap gap-2 mb-4">
                    <input type="text" id="quote-client"
                        class="flex-1 ai-input bg-gray-900/50 text-white rounded-lg px-4 py-2 border border-white/10"
                        placeholder="Client Name">
                    <input type="text" id="quote-items"
                        class="flex-1 min-w-[200px] ai-input bg-gray-900/50 text-white rounded-lg px-4 py-2 border border-white/10"
                        placeholder="Items Details">
                    <input type="number" id="quote-amount"
                        class="w-full md:w-32 ai-input bg-gray-900/50 text-white rounded-lg px-4 py-2 border border-white/10"
                        placeholder="Amount">
                    <button onclick="addQuotationEntry()"
                        class="w-full md:w-auto bg-purple-600 text-white px-6 py-2 rounded-lg font-medium">Create</button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-gray-400 text-sm border-b border-white/10">
                                <th class="pb-3">Date</th>
                                <th class="pb-3">Client</th>
                                <th class="pb-3">Details</th>
                                <th class="pb-3 text-right">Est. Amount</th>
                                <th class="pb-3"></th>
                            </tr>
                        </thead>
                        <tbody id="quote-table-body" class="text-gray-300"></tbody>
                    </table>
                </div>
            </div>
        </div>

